# ============================================================
# Petite Lavande — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------
# STRIPE
# ------------------------------------------------------------
# Found in: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook secret — from: Stripe Dashboard → Webhooks → your endpoint → Signing Secret
# For local development, use Stripe CLI: stripe listen --forward-to localhost:3000/api/checkout/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------
# ANTHROPIC (letters, chat, gift guide, phone AI, vision)
# ------------------------------------------------------------
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# GEMINI (image generation for box previews & product photos)
# ------------------------------------------------------------
# Found in: aistudio.google.com → Get API Key (free tier available)
GEMINI_API_KEY=AIza...

# ------------------------------------------------------------
# TWILIO
# ------------------------------------------------------------
# Found in: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1...

# ------------------------------------------------------------
# RESEND (abandoned cart + order confirmation emails)
# ------------------------------------------------------------
# Found in: resend.com → API Keys
# Also verify your sending domain in Resend → Domains
RESEND_API_KEY=re_...

# ------------------------------------------------------------
# SHIPPO (shipping labels)
# ------------------------------------------------------------
# Found in: goshippo.com → Settings → API
SHIPPO_API_KEY=shippo_live_...

# Your ship-from address (printed on labels)
SHIPPO_FROM_NAME=Petite Lavande
SHIPPO_FROM_STREET1=Your Street Address
SHIPPO_FROM_CITY=Your City
SHIPPO_FROM_STATE=XX
SHIPPO_FROM_ZIP=00000
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=+1...

# ------------------------------------------------------------
# CRON SECRET (protects the /api/cron/* endpoints)
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Add to Vercel → Project Settings → Environment Variables too
CRON_SECRET=generate_a_random_secret_here

# ------------------------------------------------------------
# PORTAL (admin dashboard at /portal — orders, issues, webhooks, products)
# ------------------------------------------------------------
# Password you enter at /portal/login
PORTAL_PASSWORD=choose_a_strong_admin_password
# Session token stored in the cookie — generate with: openssl rand -hex 32
PORTAL_TOKEN=generate_a_random_admin_token_here

# ------------------------------------------------------------
# RESEND AUDIENCE (newsletter signups from footer)
# ------------------------------------------------------------
# Create an audience in Resend → Audiences, then paste the ID here.
# Optional — if not set, signups are logged but not stored.
RESEND_AUDIENCE_ID=

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
# Base URL for redirect links (Stripe success/cancel URLs)
# In production: https://petitelavande.com
NEXT_PUBLIC_BASE_URL=https://petitelavande.com

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
# Show the homepage Reviews/Testimonials section.
# Keep false until you have real, verifiable customer reviews in the DB.
# Set to 'true' (string) in Vercel env vars to enable.
NEXT_PUBLIC_SHOW_REVIEWS=false
