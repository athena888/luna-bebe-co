# ============================================================
# Petite Lavande — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# Crisp live chat — when set, replaces the built-in AI chat bubble with Crisp so
# you can reply to customers from the Crisp phone/desktop app. Get this from
# crisp.chat → Settings → Website Settings → Setup (the "Website ID"). Leave blank
# to keep the built-in AI widget.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Claude↔Crisp bridge — lets your Claude AI auto-answer inside Crisp when no
# operator is online. Create a plugin token at marketplace.crisp.chat (scopes:
# conversation messages read/write + availability read) → identifier + key.
# Then add a Crisp webhook for "message:send" pointing at
#   https://petitelavande.com/api/crisp/webhook?secret=<CRISP_WEBHOOK_SECRET>
CRISP_IDENTIFIER=
CRISP_KEY=
CRISP_WEBHOOK_SECRET=
# Optional override (defaults to the public website id baked into the app):
# CRISP_WEBSITE_ID=

# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------
# STRIPE
# ------------------------------------------------------------
# Found in: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook secret — from: Stripe Dashboard → Webhooks → your endpoint → Signing Secret
# For local development, use Stripe CLI: stripe listen --forward-to localhost:3000/api/checkout/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------
# ANTHROPIC (letters, chat, gift guide, phone AI, vision)
# ------------------------------------------------------------
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# GEMINI (image generation for box previews & product photos)
# ------------------------------------------------------------
# Found in: aistudio.google.com → Get API Key (free tier available)
GEMINI_API_KEY=AIza...

# ------------------------------------------------------------
# TWILIO
# ------------------------------------------------------------
# Found in: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1...

# ------------------------------------------------------------
# RESEND (abandoned cart + order confirmation emails)
# ------------------------------------------------------------
# Found in: resend.com → API Keys
# Also verify your sending domain in Resend → Domains
RESEND_API_KEY=re_...

# ------------------------------------------------------------
# SHIPPO (shipping labels)
# ------------------------------------------------------------
# Found in: goshippo.com → Settings → API
SHIPPO_API_KEY=shippo_live_...

# Your ship-from address (printed on labels)
SHIPPO_FROM_NAME=Petite Lavande
SHIPPO_FROM_STREET1=Your Street Address
SHIPPO_FROM_CITY=Your City
SHIPPO_FROM_STATE=XX
SHIPPO_FROM_ZIP=00000
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=+1...

# ------------------------------------------------------------
# CRON SECRET (protects the /api/cron/* endpoints)
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Add to Vercel → Project Settings → Environment Variables too
CRON_SECRET=generate_a_random_secret_here

# ------------------------------------------------------------
# MARKETING COCKPIT (Daily Cockpit at /portal/cockpit)
# ------------------------------------------------------------
# Comma-separated owner addresses — lets the email webhook tell a cold email
# YOU sent (BCC) apart from an inbound reply.
OWNER_EMAILS=hello@petitelavande.com
# BCC every cold-outreach send to this address (routes to /api/inbound-email),
# so the cockpit logs the send and tracks the follow-up. Excluded from recipient
# matching. e.g. a Gmail/Resend alias that forwards to the inbound webhook.
OUTREACH_BCC_ADDRESS=log@petitelavande.com

# ------------------------------------------------------------
# GMAIL COLD-OUTREACH SENDER (domain-wide delegation)
# ------------------------------------------------------------
# The "outreach-sender" service-account JSON, as a single-line JSON string.
# ROTATE the key if it has ever been pasted anywhere — paste only the NEW key here.
GOOGLE_SA_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"outreach-sender@petite-lavande.iam.gserviceaccount.com",...}
# The Workspace user the service account impersonates. MUST be a real mailbox —
# hello@ works; emily@ does NOT exist and fails with invalid_grant.
GMAIL_SENDER=hello@petitelavande.com
# Hard daily cap on cold sends.
OUTREACH_DAILY_CAP=25
# Postal address for the CAN-SPAM footer on every cold email.
BUSINESS_ADDRESS=Petite Lavande LLC, [street, city, state ZIP]
# Optional: gap between sends (serverless-safe default 4-12s). Raise for slower pacing.
# OUTREACH_GAP_MIN_MS=4000
# OUTREACH_GAP_MAX_MS=12000

# ------------------------------------------------------------
# PORTAL (admin dashboard at /portal — orders, issues, webhooks, products)
# ------------------------------------------------------------
# Password you enter at /portal/login
PORTAL_PASSWORD=choose_a_strong_admin_password
# Session token stored in the cookie — generate with: openssl rand -hex 32
PORTAL_TOKEN=generate_a_random_admin_token_here

# ------------------------------------------------------------
# RESEND AUDIENCE (newsletter signups from footer)
# ------------------------------------------------------------
# Create an audience in Resend → Audiences, then paste the ID here.
# Optional — if not set, signups are logged but not stored.
RESEND_AUDIENCE_ID=

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
# Base URL for redirect links (Stripe success/cancel URLs)
# In production: https://petitelavande.com
NEXT_PUBLIC_BASE_URL=https://petitelavande.com

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
# Show the homepage Reviews/Testimonials section.
# Keep false until you have real, verifiable customer reviews in the DB.
# Set to 'true' (string) in Vercel env vars to enable.
NEXT_PUBLIC_SHOW_REVIEWS=false
